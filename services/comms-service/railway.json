{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --no-frozen-lockfile && pnpm --filter @xplatform/shared-types --filter @xplatform/integrations --filter @xplatform/comms-service run build"
  },
  "deploy": {
    "startCommand": "node services/comms-service/dist/index.js",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
