PORT=4004
CORS_ORIGIN=http://localhost:4000
# Optional: enables the real Claude-generated "AI Insight" / chatbot draft copy.
# Without it, the service falls back to canned deterministic responses.
ANTHROPIC_API_KEY=
# Supabase project "xBilling", schema "comms". Uses the least-privilege
# "app_service" Postgres role (scoped to this project's 5 schemas only, not
# the superuser) — get its password from whoever set up the project, or
# rotate it via the Supabase SQL editor: ALTER ROLE app_service WITH PASSWORD '...';
DATABASE_URL=postgresql://app_service:[YOUR-PASSWORD]@db.unkkskpfvrejjfgrjyab.supabase.co:5432/postgres
# Live SMS via BulkSMS — leave unset to use the mock gateway.
# BULKSMS_TOKEN_ID=
# BULKSMS_TOKEN_SECRET=
# Live email via Resend — leave unset to use the mock gateway.
# RESEND_API_KEY=
# RESEND_FROM="xBilling <billing@yourdomain.co.za>"
