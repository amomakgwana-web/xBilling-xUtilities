# Builds any one frontend in apps/<APP> and serves the static bundle via
# nginx. VITE_API_BASE_URL must be supplied at build time (Vite inlines env
# vars into the bundle) — it should point at wherever the browser can reach
# the gateway, e.g. http://localhost:4000/api for local docker-compose use.
#   docker build -f docker/Dockerfile.web --build-arg APP=web-xlayer \
#     --build-arg VITE_API_BASE_URL=http://localhost:4000/api -t xplatform/web-xlayer .
ARG NODE_VERSION=20-alpine
FROM node:${NODE_VERSION} AS build
WORKDIR /app
RUN corepack enable

COPY pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps

RUN pnpm install --no-frozen-lockfile

ARG APP
ARG VITE_API_BASE_URL=http://localhost:4000/api
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN test -n "$APP" || (echo "APP build-arg is required" && exit 1)
RUN pnpm --filter "@xplatform/shared-types" --filter "@xplatform/ui-kit" --filter "@xplatform/${APP}" run build

FROM nginx:alpine AS runtime
ARG APP
COPY docker/nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/${APP}/dist /usr/share/nginx/html

EXPOSE 80
